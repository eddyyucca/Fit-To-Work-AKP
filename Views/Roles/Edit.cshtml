@model FitToWorkApp.Controllers.Admin.RoleFormViewModel
@using FitToWorkApp.Security
@{
    var isNew = !Model.Id.HasValue;
    ViewData["Title"] = isNew ? "Tambah Role" : "Ubah Role";
    Layout = "_AdminLayout";
    var access = (AdminAccess)ViewBag.Access;
}

<div class="mb-4">
    <a asp-controller="Roles" asp-action="Index" class="small text-decoration-none">‹ Kembali ke daftar role</a>
    <h4 class="mb-0 mt-1">@ViewData["Title"]</h4>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="Roles" asp-action="Save" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Contoh: HSE Site A" autocomplete="off" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control" placeholder="Opsional" autocomplete="off" />
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <h6 class="mb-2">Hak Akses Menu</h6>
                    @if (Model.IsSuperAdmin)
                    {
                        <div class="alert alert-secondary">
                            Role <strong>Super Admin</strong> selalu punya akses ke semua menu, termasuk menu baru di masa depan.
                            Hak aksesnya tidak bisa diubah.
                        </div>
                    }
                    else
                    {
                        <span asp-validation-for="Permissions" class="text-danger small d-block mb-2"></span>
                        @foreach (var group in Permissions.All.GroupBy(p => p.Group))
                        {
                            <div class="border rounded p-3 mb-3">
                                <div class="small text-uppercase text-muted fw-semibold mb-2">@group.Key</div>
                                @foreach (var p in group)
                                {
                                    var owned = access.Has(p.Key);
                                    var id = "perm_" + p.Key.Replace(".", "_");
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="Permissions" value="@p.Key" id="@id"
                                               checked="@Model.Permissions.Contains(p.Key)" disabled="@(!owned)" />
                                        <label class="form-check-label" for="@id">
                                            @p.Label
                                            <span class="d-block text-muted small">
                                                @p.Description
                                                @if (!owned)
                                                {
                                                    <em>— Anda tidak punya hak ini, jadi tidak bisa memberikannya.</em>
                                                }
                                            </span>
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Simpan</button>
                        <a asp-controller="Roles" asp-action="Index" class="btn btn-outline-secondary">Batal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    @if (!isNew && Model.UserCount > 0)
    {
        <div class="col-lg-4 mt-3 mt-lg-0">
            <div class="alert alert-info small">
                Role ini dipakai <strong>@Model.UserCount</strong> user. Perubahan hak akses berlaku untuk mereka dalam maks. 1 menit, tanpa perlu logout.
            </div>
        </div>
    }
</div>
