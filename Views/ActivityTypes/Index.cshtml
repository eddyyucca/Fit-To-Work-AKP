@model List<ActivityType>
@{
    ViewData["Title"] = "Jenis Aktivitas";
    Layout = "_AdminLayout";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0">Jenis Aktivitas</h4>
        <div class="text-muted small">
            Pilihan yang tampil di menu <strong>Aktivitas Kebugaran</strong> karyawan. Perubahan berlaku untuk sesi berikutnya;
            riwayat lama tetap menyimpan nama aktivitas saat itu.
        </div>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Tambah Jenis</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th class="text-center">Urutan</th>
                    <th>Aktivitas</th>
                    <th>GPS</th>
                    <th>Berat badan</th>
                    <th class="text-end">Batas sesi</th>
                    <th>Kunci lokasi</th>
                    <th class="text-end">Riwayat</th>
                    <th>Status</th>
                    <th class="text-end">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr class="@(t.IsActive ? "" : "text-muted")">
                        <td class="text-center">@t.SortOrder</td>
                        <td>
                            <span class="fs-5 me-1" aria-hidden="true">@t.Ikon</span>
                            <span class="fw-semibold">@t.Nama</span>
                            <div class="small text-muted"><code>@t.Kode</code></div>
                        </td>
                        <td class="small">
                            @if (t.PakaiGps)
                            {
                                <span class="badge text-bg-info">Ya</span>
                                <div class="text-muted">maks @(t.MaksKecepatanKmh?.ToString("0.#", inv) ?? "-") km/j</div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>@(t.WajibBerat ? Html.Raw("<span class=\"badge text-bg-primary\">Wajib</span>") : Html.Raw("<span class=\"text-muted\">-</span>"))</td>
                        <td class="text-end text-nowrap">@t.MaksJam jam</td>
                        <td class="small">@ActivityLocationLock.Label(t.KunciLokasi)</td>
                        <td class="text-end">@t.JumlahSesi.ToString("N0")</td>
                        <td>@(t.IsActive ? Html.Raw("<span class=\"badge bg-success\">Aktif</span>") : Html.Raw("<span class=\"badge bg-secondary\">Nonaktif</span>"))</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Ubah</a>
                            <form asp-action="ToggleActive" asp-route-id="@t.Id" method="post" class="d-inline"
                                  data-confirm="@($"{(t.IsActive ? "Nonaktifkan" : "Aktifkan")} {t.Nama}?{(t.IsActive ? " Karyawan tidak bisa memilihnya lagi; riwayat tetap ada." : "")}")">
                                <input type="hidden" name="activate" value="@(t.IsActive ? "false" : "true")" />
                                <button type="submit" class="btn btn-sm @(t.IsActive ? "btn-outline-warning" : "btn-outline-success")">@(t.IsActive ? "Nonaktifkan" : "Aktifkan")</button>
                            </form>
                            @if (t.JumlahSesi == 0)
                            {
                                <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline"
                                      data-confirm="Hapus jenis aktivitas @t.Nama?" data-confirm-ok="Ya, Hapus">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Belum ada jenis aktivitas. Jalankan migration_fitness_activity.sql atau tambah manual.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer small text-muted">
        <strong>GPS:</strong> jarak direkam dari HP karyawan; titik yang melompat lebih cepat dari batas kecepatan dianggap lonjakan GPS dan dibuang.
        <strong>Batas sesi:</strong> belum diselesaikan sampai batas ini → "Tidak diselesaikan" (durasi & jarak tidak dihitung).
        Jenis yang sudah punya riwayat tidak bisa dihapus, hanya dinonaktifkan.
    </div>
</div>
