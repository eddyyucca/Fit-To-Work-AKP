        <script>window.AKP_HUB_URL = '@Url.Content("~/hubs/dashboard")';</script>
        <script src="~/js/dashboard-hub.js" asp-append-version="true"></script>
        @if (showFtw)
        {
            <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
            <script>
                window.FTW_DASHBOARD = {
                    dataUrl: '@Url.Action("DashboardData", "Admin")',
                    sectionUrl: '@Url.Action("DashboardSection", "Admin")',
                    sectionDetailUrl: '@Url.Action("DashboardSectionDetail", "Admin")'
                };
            </script>
            <script src="~/js/submission-detail.js" asp-append-version="true"></script>
            <script src="~/js/dashboard.js" asp-append-version="true"></script>
            <script src="~/js/dashboard-section.js" asp-append-version="true"></script>
            <script src="~/js/dashboard-pdf.js" asp-append-version="true"></script>
        }
        <script>
            window.AKP_DASH_EXTRA = {
                clinicUrl: @Json.Serialize(showClinic ? Url.Action("DashboardClinic", "Admin") : null),
                gymUrl: @Json.Serialize(showGym ? Url.Action("DashboardGym", "Admin") : null)
            };
        </script>
        <script src="~/js/dashboard-extra.js" asp-append-version="true"></script>
    }
