@model List<CheckupParameter>
@using FitToWorkApp.Services
@{
    ViewData["Title"] = "Parameter & Skor Pemkes";
    Layout = "_AdminLayout";
    var riskLevels = (List<CheckupRiskLevel>)ViewBag.RiskLevels;
    var active = Model.Where(p => p.IsActive).ToList();
    var maxScore = active.Where(p => p.IsScored).Sum(p => p.MaxPoints);
    // Minimal 1 baris kosong untuk menambah kategori
    var riskRows = riskLevels.Cast<CheckupRiskLevel?>().Append(null).ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h4 class="mb-0">Parameter &amp; Skor Pemeriksaan Kesehatan</h4>
        <div class="text-muted small">
            Isian form pemkes, kriteria + poin + warna penanda, dan kategori risiko dari total skor.
            Perubahan berlaku untuk pemeriksaan <b>baru</b>; hasil lama tetap memakai kriteria saat pemeriksaan.
        </div>
    </div>
    <a class="btn btn-primary" asp-controller="CheckupParameters" asp-action="Create">+ Tambah Parameter</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between">
        <span class="fw-semibold">Parameter (@active.Count aktif)</span>
        <span class="small text-muted">Skor maksimal saat ini: <b>@maxScore</b></span>
    </div>
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead class="table-light small">
                <tr>
                    <th style="width:70px">Urutan</th>
                    <th>Parameter</th>
                    <th>Tipe</th>
                    <th>Kriteria → poin</th>
                    <th class="text-end">Dipakai</th>
                    <th>Status</th>
                    <th class="text-end">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="@(p.IsActive ? "" : "text-muted")">
                        <td>@p.SortOrder</td>
                        <td>
                            <div class="fw-semibold">@p.Name @if (!string.IsNullOrEmpty(p.Unit)) { <span class="fw-normal small text-muted">(@p.Unit)</span> }</div>
                            @if (!p.IsScored)
                            {
                                <span class="badge bg-light text-dark border">tidak dihitung ke skor</span>
                            }
                        </td>
                        <td class="small">@CheckupInputTypes.Label(p.InputType)</td>
                        <td class="small">
                            @foreach (var c in p.Criteria)
                            {
                                <span class="badge @CheckupLevels.BadgeClass(c.Level) fw-normal mb-1">@c.Label@(c.ForSex is null ? "" : $" ({c.ForSex})") = @c.Points</span>
                            }
                        </td>
                        <td class="text-end">@(p.UsageCount > 0 ? p.UsageCount.ToString("N0") : "-")</td>
                        <td>@(p.IsActive ? Html.Raw("<span class=\"badge bg-success\">Aktif</span>") : Html.Raw("<span class=\"badge bg-secondary\">Nonaktif</span>"))</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="CheckupParameters" asp-action="Edit" asp-route-id="@p.Id">Ubah</a>
                            <form asp-controller="CheckupParameters" asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline">
                                <input type="hidden" name="activate" value="@(p.IsActive ? "false" : "true")" />
                                <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-warning" : "btn-outline-success")">@(p.IsActive ? "Nonaktifkan" : "Aktifkan")</button>
                            </form>
                            @if (p.UsageCount == 0)
                            {
                                <form asp-controller="CheckupParameters" asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                      data-confirm="Hapus parameter '@p.Name'?" data-confirm-ok="Ya, Hapus">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted">Belum ada parameter. Jalankan Database/migration_pemkes_parameter.sql untuk isi awal, atau tambah manual.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">Kategori Risiko (interpretasi total skor)</div>
    <form asp-controller="CheckupParameters" asp-action="RiskLevels" method="post" id="riskForm">
        <div class="table-responsive">
            <table class="table table-sm mb-0 align-middle" id="riskTable">
                <thead class="table-light small">
                    <tr>
                        <th style="width:110px">Skor min</th>
                        <th style="width:110px">Skor maks</th>
                        <th style="min-width:12rem">Nama kategori</th>
                        <th style="width:140px">Warna</th>
                        <th>Keterangan / tindakan</th>
                        <th style="width:2.5rem"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in riskRows)
                    {
                        <tr class="risk-row">
                            <td><input type="number" class="form-control form-control-sm" data-field="MinScore" value="@r?.MinScore" min="-999" max="999" /></td>
                            <td><input type="number" class="form-control form-control-sm" data-field="MaxScore" value="@r?.MaxScore" min="-999" max="999" placeholder="ke atas" /></td>
                            <td><input class="form-control form-control-sm" data-field="Label" value="@r?.Label" maxlength="50" /></td>
                            <td>
                                <select class="form-select form-select-sm" data-field="Color">
                                    @foreach (var c in RiskColors.All)
                                    {
                                        <option value="@c" selected="@(r?.Color == c)">@RiskColors.Label(c)</option>
                                    }
                                </select>
                            </td>
                            <td><input class="form-control form-control-sm" data-field="Description" value="@r?.Description" maxlength="250" /></td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger risk-del" aria-label="Hapus baris">×</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-body d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-primary" id="riskAdd">+ Baris</button>
            <button type="submit" class="btn btn-sm btn-primary">Simpan Kategori Risiko</button>
            <span class="small text-muted align-self-center">Skor maks kosong = ke atas. Rentang tidak boleh tumpang tindih.</span>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const tbody = document.querySelector('#riskTable tbody');
            const template = tbody.querySelector('.risk-row:last-child').cloneNode(true);
            document.getElementById('riskAdd').addEventListener('click', () => {
                const tr = template.cloneNode(true);
                tr.querySelectorAll('input').forEach((i) => i.value = '');
                tbody.appendChild(tr);
            });
            tbody.addEventListener('click', (e) => {
                if (!e.target.classList.contains('risk-del')) return;
                if (tbody.rows.length > 1) e.target.closest('tr').remove();
                else e.target.closest('tr').querySelectorAll('input').forEach((i) => i.value = '');
            });
            // Nama field berurutan: levels[0].MinScore, ...
            document.getElementById('riskForm').addEventListener('submit', () => {
                [...tbody.rows].forEach((tr, i) => tr.querySelectorAll('[data-field]').forEach((el) => el.name = `levels[${i}].${el.dataset.field}`));
            });
        })();
    </script>
}
