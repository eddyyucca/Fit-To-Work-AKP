@model FitToWorkApp.Controllers.PortalChangePasswordViewModel
@{
    ViewData["Title"] = "Ganti Password - Riwayat Saya";
    ViewData["AuthPage"] = true;
    var employee = (Employee)ViewBag.Employee;
}

<div class="row justify-content-center">
    <div class="col-sm-9 col-md-6 col-lg-5">
        <partial name="_AuthLogo" model="@("Riwayat Saya")" />
        <div class="card akp-auth-card">
            <div class="card-body p-4">
                <div class="text-center">
                    <h5 class="mb-1"><i class="bi bi-key me-1"></i>@(Model.Wajib ? "Buat Password Baru" : "Ganti Password")</h5>
                    <p class="text-muted small mb-3">@employee.Nama · NIP @employee.NIP</p>
                </div>

                @if (Model.Wajib)
                {
                    <div class="alert alert-warning py-2 small">
                        Anda masuk dengan password awal (tanggal lahir). Demi keamanan data kesehatan Anda,
                        buat password baru dulu sebelum membuka Riwayat Saya.
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <form asp-controller="Portal" asp-action="ChangePassword" method="post" autocomplete="off">
                    @if (!Model.Wajib)
                    {
                        <div class="mb-3">
                            <label class="form-label" asp-for="PasswordLama">Password lama</label>
                            <input asp-for="PasswordLama" type="password" class="form-control form-control-lg js-pwd" autocomplete="current-password" autofocus required />
                            <span asp-validation-for="PasswordLama" class="text-danger small"></span>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label" asp-for="PasswordBaru">Password baru</label>
                        <input asp-for="PasswordBaru" type="password" class="form-control form-control-lg js-pwd" autocomplete="new-password"
                               minlength="@FitToWorkApp.Services.PortalPasswordRules.MinLength" maxlength="@FitToWorkApp.Services.PortalPasswordRules.MaxLength"
                               autofocus="@Model.Wajib" />
                        <span asp-validation-for="PasswordBaru" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="UlangiPassword">Ulangi password baru</label>
                        <input asp-for="UlangiPassword" type="password" class="form-control form-control-lg js-pwd" autocomplete="new-password"
                               maxlength="@FitToWorkApp.Services.PortalPasswordRules.MaxLength" />
                        <span asp-validation-for="UlangiPassword" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="showPwd" />
                        <label class="form-check-label small" for="showPwd">Tampilkan password</label>
                    </div>
                    <ul class="small text-muted ps-3 mb-4">
                        <li>Minimal @FitToWorkApp.Services.PortalPasswordRules.MinLength karakter</li>
                        <li>Tidak boleh sama dengan NIP atau tanggal lahir</li>
                        <li>Simpan baik-baik. Kalau lupa, minta HR/admin me-reset password Anda.</li>
                    </ul>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Simpan Password</button>
                </form>

                <hr class="my-3" />
                <div class="d-flex justify-content-between align-items-center small">
                    @if (!Model.Wajib)
                    {
                        <a asp-controller="Portal" asp-action="Index">‹ Kembali ke Riwayat Saya</a>
                    }
                    else
                    {
                        <span></span>
                    }
                    <form asp-controller="Portal" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-link btn-sm text-danger p-0">Keluar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('showPwd').addEventListener('change', function () {
            document.querySelectorAll('.js-pwd').forEach((i) => i.type = this.checked ? 'text' : 'password');
        });
    </script>
}
