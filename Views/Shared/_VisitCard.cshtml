@* Ringkasan satu kunjungan klinik (keluhan, diagnosa, obat, rekomendasi). Dipakai di rekam medis admin & portal karyawan. *@
@model ClinicVisit
@inject FitToWorkApp.Services.IAppClock Clock
@{
    var showLink = ViewData["ShowAdminLink"] as bool? == true;
}
<div class="card shadow-sm mb-3 @(Model.IsCancelled ? "opacity-50" : "")">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between gap-2 align-items-center">
        <div>
            <span class="fw-semibold">@Clock.ToLocal(Model.VisitAt).ToString("dd/MM/yyyy HH:mm")</span>
            @if (Model.IsCancelled)
            {
                <span class="badge bg-secondary ms-1">Dibatalkan</span>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @RecommendationTypes.BadgeClass(Model.Rekomendasi)">@Model.RekomendasiLabel</span>
            @if (showLink)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-controller="ClinicVisits" asp-action="Detail" asp-route-id="@Model.Id">Detail</a>
            }
        </div>
    </div>
    <div class="card-body">
        <div class="mb-2"><span class="text-muted small d-block">Keluhan</span>@Model.Keluhan</div>
        @if (!string.IsNullOrEmpty(Model.Pemeriksaan))
        {
            <div class="mb-2"><span class="text-muted small d-block">Hasil pemeriksaan</span>@Model.Pemeriksaan</div>
        }
        @if (!string.IsNullOrEmpty(Model.DiagnosaText))
        {
            <div class="mb-2"><span class="text-muted small d-block">Jenis penyakit / diagnosa</span>@Model.DiagnosaText</div>
        }
        @if (Model.Medicines.Count > 0)
        {
            <div class="mb-2">
                <span class="text-muted small d-block">Obat</span>
                <ul class="mb-0 ps-3">
                    @foreach (var m in Model.Medicines)
                    {
                        <li>@m.NamaSnapshot — @m.Qty @m.SatuanSnapshot @(string.IsNullOrEmpty(m.AturanPakai) ? "" : "· " + m.AturanPakai)</li>
                    }
                </ul>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.CatatanRekomendasi))
        {
            <div class="mb-2"><span class="text-muted small d-block">Catatan rekomendasi</span>@Model.CatatanRekomendasi</div>
        }
        <div class="small text-muted">Pemeriksa: @Model.ExaminerName</div>
        @if (Model.IsCancelled)
        {
            <div class="small text-danger mt-1">Dibatalkan oleh @Model.CancelledBy: @Model.CancelReason</div>
        }
    </div>
</div>
