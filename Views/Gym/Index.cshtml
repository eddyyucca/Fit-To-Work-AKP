@model GymFormViewModel
@{
    ViewData["Title"] = "Aktivitas Kebugaran";
    var selected = Model.Types.FirstOrDefault(t => t.Id == Model.ActivityTypeId);
}

<style>
    .act-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: .6rem; }
    .act-tile { position: relative; margin: 0; cursor: pointer; }
    .act-tile input { position: absolute; opacity: 0; pointer-events: none; }
    .act-tile .act-body {
        display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
        min-height: 104px; padding: .6rem .4rem; border: 2px solid #dee2e6; border-radius: .75rem; background: #fff;
        transition: border-color .1s ease, box-shadow .1s ease, transform .1s ease;
    }
    .act-tile .act-icon { font-size: 2rem; line-height: 1.1; }
    .act-tile .act-name { font-weight: 600; margin-top: .25rem; line-height: 1.15; }
    .act-tile .act-hint { font-size: .72rem; color: #6c757d; margin-top: .15rem; }
    .act-tile input:checked + .act-body { border-color: var(--akp-blue, #1a8fd8); background: #eef7fd; box-shadow: 0 .25rem .75rem rgba(26,143,216,.18); }
    .act-tile input:focus-visible + .act-body { outline: 3px solid rgba(26,143,216,.4); outline-offset: 2px; }
    .act-tile .act-body:active { transform: scale(.98); }
</style>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-3 p-md-4 form-card-body">
                <h4 class="mb-1">🏃 Aktivitas Kebugaran</h4>
                <p class="text-muted small">
                    Pilih aktivitas, tekan <strong>Mulai</strong>, lalu <strong>Selesai</strong> setelah berolahraga supaya lamanya tercatat.
                    Untuk lari, jalan cepat, hiking &amp; bersepeda, <strong>jarak direkam lewat GPS</strong> HP.
                </p>

                @if (TempData["Info"] is string info)
                {
                    <div class="alert alert-warning small">@info</div>
                }

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @if (Model.Types.Count == 0)
                {
                    <div class="alert alert-secondary">Belum ada jenis aktivitas yang aktif. Hubungi admin.</div>
                    <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary w-100">Kembali ke Menu</a>
                }
                else
                {
                    <form asp-controller="Gym" asp-action="Index" method="post" id="gymForm" data-location-guard>
                        <h6 class="form-section-title">Pilih Aktivitas</h6>
                        <div class="act-grid mb-1" role="radiogroup" aria-label="Jenis aktivitas">
                            @foreach (var t in Model.Types)
                            {
                                var hint = t.PakaiGps ? "📡 Jarak GPS" : t.WajibBerat ? "⚖️ Isi berat badan" : "⏱️ Catat durasi";
                                <label class="act-tile">
                                    <input type="radio" name="ActivityTypeId" value="@t.Id" checked="@(t.Id == Model.ActivityTypeId)"
                                           data-nama="@t.Nama" data-berat="@(t.WajibBerat ? "1" : "0")" data-gps="@(t.PakaiGps ? "1" : "0")"
                                           data-lock="@t.KunciLokasi" data-jam="@t.MaksJam" />
                                    <span class="act-body">
                                        <span class="act-icon" aria-hidden="true">@t.Ikon</span>
                                        <span class="act-name">@t.Nama</span>
                                        <span class="act-hint">@hint</span>
                                    </span>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="ActivityTypeId" class="text-danger small d-block mb-2"></span>
                        <div class="small text-muted mb-3" id="actRule">&nbsp;</div>

                        <partial name="_LocationStatus" model="(LocationUiModel)ViewBag.Location" />

                        <div id="beratSection" class="@(selected?.WajibBerat == true ? "" : "d-none")">
                            <h6 class="form-section-title">Berat Badan</h6>
                            <div class="mb-3">
                                <label asp-for="BeratBadan" class="form-label small text-muted mb-1"></label>
                                <div class="input-group input-group-lg">
                                    <input asp-for="BeratBadan" type="number" step="0.1"
                                           min="@GymFormViewModel.MinBerat" max="@GymFormViewModel.MaxBerat"
                                           inputmode="decimal" class="form-control text-center" placeholder="Contoh: 68.5" autocomplete="off" />
                                    <span class="input-group-text">kg</span>
                                </div>
                                <span asp-validation-for="BeratBadan" class="text-danger small"></span>
                            </div>
                        </div>

                        <details class="small text-muted mb-3">
                            <summary>Data diri</summary>
                            <div class="mt-2">
                                @Model.Nama · NIK @Model.NIP<br />
                                @(string.IsNullOrEmpty(Model.Department) ? "-" : Model.Department) · @(string.IsNullOrEmpty(Model.Position) ? "-" : Model.Position)
                                <div>Data diri tidak sesuai? Hubungi admin/HR.</div>
                            </div>
                        </details>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg" id="btnSubmit"><i class="bi bi-play-fill me-1"></i><span id="btnLabel">Mulai</span></button>
                            <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary">Kembali ke Menu</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/location-guard.js" asp-append-version="true"></script>
    <script>
        (function () {
            var form = document.getElementById('gymForm');
            if (!form) return;
            var radios = form.querySelectorAll('input[name="ActivityTypeId"]');
            var berat = document.getElementById('beratSection');
            var beratInput = document.getElementById('BeratBadan');
            var rule = document.getElementById('actRule');
            var label = document.getElementById('btnLabel');
            var btn = document.getElementById('btnSubmit');
            var lockText = {
                MulaiSelesai: 'mulai & selesai wajib di area site',
                Mulai: 'mulai di area site, selesai boleh di mana saja',
                Tidak: 'tanpa kunci lokasi'
            };

            function current() {
                for (var i = 0; i < radios.length; i++) if (radios[i].checked) return radios[i];
                return null;
            }

            function apply() {
                var r = current();
                var needBerat = !!r && r.dataset.berat === '1';
                berat.classList.toggle('d-none', !needBerat);
                beratInput.required = needBerat;
                if (!needBerat) beratInput.value = '';

                // Belum memilih aktivitas: tombol ditahan (location-guard.js ikut menghormati data-submit-hold)
                form.dataset.submitHold = r ? '0' : '1';
                btn.disabled = !r;
                label.textContent = r ? 'Mulai ' + r.dataset.nama : 'Mulai';
                rule.textContent = r
                    ? (r.dataset.gps === '1' ? 'Jarak direkam GPS · ' : '') + 'Batas ' + r.dataset.jam + ' jam · ' + (lockText[r.dataset.lock] || '')
                    : '\u00a0';

                // Jenis tanpa kunci lokasi: kotak lokasi disembunyikan & tombol tidak dikunci.
                // Selain itu location-guard.js yang menentukan tombol terkunci/tidak sesuai hasil cek lokasi.
                if (window.AKP_LOCATION_SKIP) window.AKP_LOCATION_SKIP(!!r && r.dataset.lock === 'Tidak');
            }

            radios.forEach(function (r) { r.addEventListener('change', apply); });
            apply();

            form.addEventListener('submit', function (e) {
                if (!current()) { e.preventDefault(); return; }
                setTimeout(function () { btn.disabled = true; }, 0);
            });
        })();
    </script>
}
