@model FitToWorkSubmission
@inject FitToWorkApp.Services.IAppClock Clock
@{
    ViewData["Title"] = "Berhasil Dikirim";
    Layout = null; // halaman berdiri sendiri, supaya navbar/tombol "Keluar" di layout tidak bikin bingung saat auto-redirect
    var isFit = Model.KesiapanKerja.StartsWith("YA");
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AKP Sehat</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fontsource/source-sans-3@5.0.12/index.css" />
    <link rel="stylesheet" href="~/lib/adminlte/css/adminlte.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/akp-theme.css" asp-append-version="true" />
</head>
<body class="akp-auth-bg">
    <div class="container pt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="text-center mb-3"><img src="~/images/akp-sehat-logo.png" alt="AKP Sehat" style="max-width:120px" /></div>
                <div class="card akp-auth-card text-center">
                    <div class="card-body p-4 p-md-5">
                        <div style="font-size:3rem;">@(isFit ? "✅" : "⚠️")</div>
                        <h4 class="mt-3">Terima kasih, @Model.NamaSnapshot!</h4>
                        <p class="text-muted">Data Fit To Work Anda pada @Clock.ToLocal(Model.CreatedAt).ToString("dd/MM/yyyy, HH:mm") berhasil disimpan.</p>

                        @if (isFit)
                        {
                            <div class="alert alert-success">Anda tercatat <strong>SIAP &amp; FIT</strong> untuk bekerja hari ini. Tetap utamakan keselamatan!</div>
                        }
                        else
                        {
                            <div class="alert alert-danger">
                                Anda tercatat <strong>TIDAK FIT/KURANG SEHAT</strong>. Segera lapor ke Pengawas/Foreman dan kunjungi klinik site sebelum memulai pekerjaan.
                            </div>
                        }

                        <p class="text-muted small mb-3">
                            Anda akan otomatis kembali ke menu utama dalam <span id="countdown">5</span> detik.
                        </p>

                        <a asp-controller="Menu" asp-action="Index" class="btn btn-primary w-100">Kembali ke Menu Utama Sekarang</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Setelah submit, otomatis kembali ke Menu (karyawan tetap login di HP-nya sendiri).
        var seconds = 5;
        var countdownEl = document.getElementById('countdown');
        var timer = setInterval(function () {
            seconds--;
            countdownEl.textContent = seconds;
            if (seconds <= 0) {
                clearInterval(timer);
                window.location.href = '@Url.Action("Index", "Menu")';
            }
        }, 1000);
    </script>
</body>
</html>
