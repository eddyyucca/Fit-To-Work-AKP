@{
    ViewData["Title"] = "Pemeriksaan Kesehatan";
    Layout = "_AdminLayout";
    var departments = (List<string>)ViewBag.Departments;
}

<style>
    #checkupTable td { vertical-align: middle; }
    #checkupTable td.nowrap { white-space: nowrap; }
    .dataTables_processing { background: rgba(255,255,255,.85) !important; border: 0 !important; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h4 class="mb-0">Pemeriksaan Kesehatan</h4>
        <div class="text-muted small">Hasil pemeriksaan berkala oleh medic, dengan total skor risiko. Kriteria & poin diatur di menu Parameter &amp; Skor Pemkes.</div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="small text-muted me-2" id="summary">&nbsp;</div>
        <a class="btn btn-outline-primary btn-sm" asp-controller="Checkups" asp-action="FollowUps">📅 Follow Up</a>
        <button type="button" class="btn btn-success btn-sm" id="btnExportExcel">📥 Download Excel</button>
        <a class="btn btn-outline-success btn-sm" asp-controller="Checkups" asp-action="Import">📤 Import Excel</a>
        <a class="btn btn-primary btn-sm" asp-controller="Checkups" asp-action="Create">+ Input Pemeriksaan</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body pb-0">
        <form id="filter" class="row g-2 align-items-end" autocomplete="off">
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="fFrom">Dari Tanggal</label>
                <input type="date" id="fFrom" name="from" class="form-control form-control-sm" value="@ViewBag.DefaultFrom" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="fTo">Sampai Tanggal</label>
                <input type="date" id="fTo" name="to" class="form-control form-control-sm" value="@ViewBag.DefaultTo" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small mb-1" for="fDept">Department</label>
                <select id="fDept" name="department" class="form-select form-select-sm">
                    <option value="">Semua Department</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d">@d</option>
                    }
                </select>
            </div>
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm mb-0 w-100" id="checkupTable">
                <thead class="table-light">
                    <tr>
                        <th>Waktu</th>
                        <th>NIP</th>
                        <th>Nama</th>
                        <th>Department</th>
                        <th>Skor</th>
                        <th>Risiko</th>
                        <th>Nilai di luar normal</th>
                        <th class="text-end">Aksi</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.FTW_CHECKUP = {
            dataUrl: '@Url.Action("Data", "Checkups")',
            exportUrl: '@Url.Action("Export", "Checkups")',
            detailUrl: '@Url.Action("Detail", "Checkups", new { id = 0 })'.replace(/\/0$/, '/'),
            recordUrl: '@Url.Action("Employee", "MedicalRecord", new { id = 0 })'.replace(/\/0$/, '/')
        };
    </script>
    <script src="~/js/checkups.js" asp-append-version="true"></script>
}
