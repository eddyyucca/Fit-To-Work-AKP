@{
    ViewData["Title"] = "Log Akses";
    Layout = "_AdminLayout";
    var usernames = (List<string>)ViewBag.Usernames;
    var selectedUser = ViewBag.SelectedUsername as string;
    var selectedEvent = ViewBag.SelectedEventType as string;
}

<style>
    #logTable td { vertical-align: middle; }
    #logTable .log-path { font-family: var(--bs-font-monospace); font-size: .75rem; color: #6c757d; word-break: break-all; }
    .dataTables_processing { background: rgba(255,255,255,.85) !important; border: 0 !important; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h4 class="mb-0">Log Akses</h4>
        <div class="text-muted small">Login, logout, akses ditolak, halaman yang dibuka, download &amp; perubahan data oleh admin.</div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-3">
        <div class="small text-muted" id="logSummary">&nbsp;</div>
        <button type="button" class="btn btn-success btn-sm" id="btnExportExcel" title="Download sesuai filter yang sedang aktif">
            <span class="spinner-border spinner-border-sm me-1 d-none" role="status" aria-hidden="true"></span>
            📥 Download Excel
        </button>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body pb-0">
        <form id="logFilter" class="row g-2 align-items-end" autocomplete="off">
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="fFrom">Dari Tanggal</label>
                <input type="date" id="fFrom" name="from" class="form-control form-control-sm" value="@ViewBag.DefaultFrom" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="fTo">Sampai Tanggal</label>
                <input type="date" id="fTo" name="to" class="form-control form-control-sm" value="@ViewBag.DefaultTo" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="fUser">User</label>
                <select id="fUser" name="username" class="form-select form-select-sm">
                    <option value="">Semua user</option>
                    @foreach (var u in usernames)
                    {
                        <option value="@u" selected="@(u == selectedUser)">@u</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="fEvent">Jenis</label>
                <select id="fEvent" name="eventType" class="form-select form-select-sm">
                    <option value="">Semua jenis</option>
                    @foreach (var e in AccessLogEvents.All)
                    {
                        <option value="@e" selected="@(e == selectedEvent)">@AccessLogEvents.Label(e)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-1 d-grid">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnResetFilter">Reset</button>
            </div>
            <div class="col-12">
                <div class="btn-group btn-group-sm mt-1" role="group" aria-label="Rentang cepat">
                    <button type="button" class="btn btn-outline-primary" data-range="0">Hari ini</button>
                    <button type="button" class="btn btn-outline-primary" data-range="6">7 hari</button>
                    <button type="button" class="btn btn-outline-primary" data-range="29">30 hari</button>
                    <button type="button" class="btn btn-outline-primary" data-range="all">Semua</button>
                </div>
            </div>
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table mb-0 align-middle w-100" id="logTable">
                <thead class="table-light">
                    <tr>
                        <th>Waktu</th>
                        <th>User</th>
                        <th>Jenis</th>
                        <th>Aktivitas</th>
                        <th>IP</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.FTW_LOG = {
            dataUrl: '@Url.Action("Data", "AccessLogs")',
            exportUrl: '@Url.Action("Export", "AccessLogs")',
            maxExportRows: @FitToWorkApp.Controllers.Admin.AccessLogsController.MaxExportRows,
            defaultFrom: '@ViewBag.DefaultFrom',
            defaultTo: '@ViewBag.DefaultTo'
        };
    </script>
    <script src="~/js/access-logs.js" asp-append-version="true"></script>
}
