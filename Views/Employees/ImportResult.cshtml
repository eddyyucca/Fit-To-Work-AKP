@model ImportEmployeeResultViewModel
@{
    ViewData["Title"] = "Hasil Import";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Hasil Import Data Karyawan</h4>
    <div>
        <a asp-controller="Employees" asp-action="Import" class="btn btn-outline-secondary btn-sm">Import Lagi</a>
        <a asp-controller="Employees" asp-action="Index" class="btn btn-primary btn-sm">Lihat Data Karyawan</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Total Baris</div>
                <div class="fs-4 fw-bold">@Model.TotalRows</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Karyawan Baru</div>
                <div class="fs-4 fw-bold text-success">@Model.TotalCreated</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Diperbarui</div>
                <div class="fs-4 fw-bold text-info">@Model.TotalUpdated</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Gagal</div>
                <div class="fs-4 fw-bold text-danger">@Model.TotalFailed</div>
            </div>
        </div>
    </div>
</div>

@if (Model.OrgNotes.Count > 0)
{
    <div class="alert alert-info small">
        <div class="fw-semibold mb-1">Perubahan Data Organisasi</div>
        <ul class="mb-0">
            @foreach (var note in Model.OrgNotes)
            {
                <li>@note</li>
            }
        </ul>
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Baris</th>
                    <th>NIP</th>
                    <th>Nama</th>
                    <th>Status</th>
                    <th>Keterangan</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Tidak ada baris data yang terbaca dari file.</td></tr>
                }
                @foreach (var r in Model.Rows)
                {
                    <tr class="@(r.IsSuccess ? "" : "table-danger")">
                        <td>@r.RowNumber</td>
                        <td>@r.NIP</td>
                        <td>@r.Nama</td>
                        <td>
                            @if (r.IsSuccess)
                            {
                                <span class="badge bg-success">Sukses</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Gagal</span>
                            }
                        </td>
                        <td>@r.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
