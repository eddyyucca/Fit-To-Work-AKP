# Copy file ini jadi ".env" (tanpa akhiran .example), lalu isi nilai di bawah
# sesuai environment production Anda. JANGAN commit file ".env" ke Git.

# --- Database (SQL Server existing: container "mssql2022") ---
DB_SERVER=mssql2022,1433
DB_NAME=FitToWorkDb
DB_USER=sa
DB_PASSWORD=GANTI_DENGAN_PASSWORD_SA_ANDA

# --- HRIS (sinkron karyawan lewat REST API, baca-saja) ---
# Token sama dengan HRIS_API_TOKEN di HRIS. Kosongkan kalau belum dipakai.
# Di server yang sama dengan HRIS: HRIS_API_URL=http://host.docker.internal:8101 (port HRIS di server)
HRIS_API_URL=
HRIS_API_TOKEN=
# Sinkron otomatis tiap sekian menit (bawaan 60). 0 = mati; tombol manual di menu admin tetap ada.
HRIS_SYNC_INTERVAL_MINUTES=60

# --- Aplikasi ---
APP_PORT=8080
APP_VERSION=latest
